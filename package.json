{
  "name": "codex-control-console",
  "version": "0.1.0",
  "private": true,
  "description": "Loopback Codex Control Console MVP",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-terminal.mjs",
    "start": "node src/main.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs && node scripts/structure-check.mjs",
    "check:structure": "node scripts/structure-check.mjs",
    "inspect": "node scripts/inspect.mjs",
    "prepare:wrapper": "node scripts/prepare-wrapper.mjs",
    "enable:primary-bridge": "node scripts/enable-primary-owner-bridge.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "ws": "8.21.3"
  }
}
